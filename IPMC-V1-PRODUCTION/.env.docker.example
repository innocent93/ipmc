# Copy this to .env before running `docker compose up --build`
JWT_SECRET=change-this-to-a-long-random-string
COOKIE_SECRET=change-this-to-a-different-long-random-string
ADMIN_EMAIL=admin@ipmc-ng.com

CLIENT_URL=http://localhost:8080
ADMIN_URL=http://localhost:8081
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

# Build-time API URLs baked into each frontend's static build
CLIENT_API_URL=http://localhost:5000/api
ADMIN_API_URL=http://localhost:5000/api

# Optional — leave blank to skip email sending (contact/newsletter/reset
# still work; see docs/DEPLOYMENT_FIX.md)
RESEND_API_KEY=re_dummy_replace_with_real_key
RESEND_FROM_EMAIL="IPMC Nigeria <onboarding@resend.dev>"
