PORT=5000
MONGO_URI=mongodb://localhost:27017/ipmc
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# Access token lifetime — kept short since it's silently renewed via the
# refresh token cookie (7-day, rotated on each use). 30d here previously
# meant a stolen access token stayed valid for a month; 15m bounds that
# window sharply while POST /auth/refresh keeps real sessions seamless.
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRE=7d
ADMIN_EMAIL=admin@ipmc-ng.com

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email — Resend (https://resend.com), not raw SMTP. Many hosts (Render's
# free/starter tiers included) block outbound SMTP ports 25/465/587
# entirely, which silently prevented emails from ever sending even with
# correct SMTP credentials. Resend sends over plain HTTPS instead, so it
# isn't affected by that kind of port blocking — this is *why* emails
# weren't arriving before, not just a preference swap.
#
# Get a real key at https://resend.com/api-keys (free tier available).
# The value below is a placeholder, not a real key — the app detects this
# exact placeholder and skips sending (logs a warning) rather than trying
# to authenticate with it, so nothing hangs or crashes with it left as-is.
# Contact/newsletter/reset-password flows all still work without a real
# key configured — messages save to MongoDB and respond normally either
# way; only the notification email itself is skipped.
RESEND_API_KEY=re_dummy_replace_with_real_key
# Must be a domain you've verified in Resend, OR the Resend sandbox
# sender below (works immediately, no domain verification, but can only
# send to the email address on your Resend account — fine for testing,
# not for real production traffic to arbitrary recipients).
RESEND_FROM_EMAIL="IPMC Nigeria <onboarding@resend.dev>"

# Frontend URLs
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Comma-separated list of allowed CORS origins (recommended over CLIENT_URL
# alone once you have a production frontend URL). Vercel *.vercel.app
# preview URLs for this project are always allowed automatically.
CORS_ORIGIN=http://localhost:5173,https://ipmc.vercel.app

# Error monitoring (optional). Unset by default — errors log locally via
# the structured logger regardless. Add a real Sentry (or similar) DSN
# here once you have an account; see server/utils/errorReporter.js for
# exactly what to change to wire it in fully.
SENTRY_DSN=
APP_NAME=IPMC Nigeria
APP_URL=https://ipmc-ng.com
APP_DESCRIPTION="Integrated Project Management Consultancy"
